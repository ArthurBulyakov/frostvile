<?php
/**
 * Пример приёма заявки на хостинге Макхост.
 * Не работает, пока вы сами не переименуете файл в send.php
 * и не подставите настоящие адреса вместо заглушек.
 *
 * В js/config.js поставьте:
 *   mode: "php",
 *   endpoint: "send.php",
 *
 * На Макхосте письмо обычно уходит только если адрес «От кого»
 * — это ящик, созданный в панели для вашего домена.
 */

header("Content-Type: application/json; charset=utf-8");

if (($_SERVER["REQUEST_METHOD"] ?? "") !== "POST") {
    http_response_code(405);
    echo json_encode(array("ok" => false, "error" => "Нужен POST"), JSON_UNESCAPED_UNICODE);
    exit;
}

$to = "info@frostvile.ru";
$from = "[email отправителя]";

function field($key, $max)
{
    $value = isset($_POST[$key]) ? (string) $_POST[$key] : "";
    $value = trim(str_replace(array("\r", "\n"), " ", $value));
    if (function_exists("mb_substr")) {
        return mb_substr($value, 0, $max, "UTF-8");
    }
    return substr($value, 0, $max);
}

if ($to === "" || strpos($to, "[") !== false || !filter_var($to, FILTER_VALIDATE_EMAIL)) {
    http_response_code(500);
    echo json_encode(array("ok" => false, "error" => "Укажите адрес получателя в send.php"), JSON_UNESCAPED_UNICODE);
    exit;
}

if ($from === "" || strpos($from, "[") !== false || !filter_var($from, FILTER_VALIDATE_EMAIL)) {
    http_response_code(500);
    echo json_encode(array("ok" => false, "error" => "Укажите адрес отправителя с вашего домена"), JSON_UNESCAPED_UNICODE);
    exit;
}

if (trim(isset($_POST["website"]) ? (string) $_POST["website"] : "") !== "") {
    echo json_encode(array("ok" => true));
    exit;
}

$name = field("name", 80);
$company = field("company", 120);
$phone = field("phone", 40);
$comment = field("comment", 2000);
$consent = isset($_POST["consent"]) ? (string) $_POST["consent"] : "";

if ($name === "" || $company === "" || $phone === "" || $consent === "") {
    http_response_code(400);
    echo json_encode(array("ok" => false, "error" => "Заполните имя, компанию, телефон и согласие"), JSON_UNESCAPED_UNICODE);
    exit;
}

$body = "Заявка с сайта Фроствиль\n\n"
    . "Имя: {$name}\n"
    . "Компания: {$company}\n"
    . "Телефон: {$phone}\n"
    . "Комментарий: " . ($comment !== "" ? $comment : "—") . "\n";

$subject = "=?UTF-8?B?" . base64_encode("Заявка с сайта Фроствиль") . "?=";
$headers = "MIME-Version: 1.0\r\n"
    . "Content-Type: text/plain; charset=UTF-8\r\n"
    . "From: {$from}\r\n";

if (!mail($to, $subject, $body, $headers)) {
    http_response_code(500);
    echo json_encode(array("ok" => false, "error" => "Почта на хостинге не приняла письмо"), JSON_UNESCAPED_UNICODE);
    exit;
}

echo json_encode(array("ok" => true), JSON_UNESCAPED_UNICODE);
